{
  "name": "vibe_survivors_client",
  "homepage": "https://www.survive-with-friends.com/",
  "version": "1.0.0",
  "description": "Phaser client for Vibe Survivors",
  "main": "src/main.ts",
  "scripts": {
    "start": "vite --host",
    "build": "vite build",
    "serve": "vite preview",
    "predeploy": "npm run build && echo survive-with-friends.com > dist/CNAME",
    "deploy": "gh-pages -d dist",
    "generate-bindings": "spacetime generate --lang typescript --out-dir ./src/autobindings"
  },
  "author": "maximilian georg",
  "license": "ISC",
  "dependencies": {
    "phaser": "^4.0.0",
    "spacetimedb": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "latest",
    "vite": "latest"
  }
}
